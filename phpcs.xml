<?xml version="1.0"?>
<ruleset name="CakePHP">
    <description>CakePHP Coding Standards</description>

    <rule ref="CakePHP"/>

    <!-- Long lines: plantillas HTML y strings de templates son intencionales. -->
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
    <!-- @ en cleanup(): borrado recursivo donde los fallos no son bloqueantes. -->
    <rule ref="Generic.PHP.NoSilencedErrors">
        <severity>0</severity>
    </rule>
    <!-- Métodos encadenables con return type self (requerido por interfaces). -->
    <rule ref="CakePHP.Classes.ReturnTypeHint">
        <severity>0</severity>
    </rule>

    <arg value="p"/>
    <arg name="colors"/>

    <arg name="extensions" value="php"/>

    <file>src/</file>
    <file>tests/</file>
</ruleset>